# Agente Navegador — Balão da Informática Castelo
# Variáveis de ambiente — COPIE este arquivo para .env e ajuste os valores
# NUNCA suba o arquivo .env para o repositório!

# ── Navegador ──────────────────────────────────────────────────────────────
# false = navegador visível (recomendado para uso supervisionado)
# true  = headless (sem interface visual — NÃO recomendado para produção)
BROWSER_HEADLESS=false

# Diretório do perfil local do navegador (NÃO suba para o GitHub)
BROWSER_PROFILE_DIR=browser-profile

# Timeout padrão para ações do navegador (em milissegundos)
DEFAULT_TIMEOUT_MS=30000

# ── Diretórios ──────────────────────────────────────────────────────────────
# Onde salvar screenshots gerados pelo agente
SCREENSHOT_DIR=screenshots

# Onde salvar logs de execução
LOG_DIR=logs

# ── Segurança ───────────────────────────────────────────────────────────────
# true  = exige confirmação antes de ações críticas (RECOMENDADO)
# false = modo silencioso (NÃO recomendado em produção)
REQUIRE_CONFIRMATION=true

# ── NUNCA adicione tokens, senhas, chaves ou cookies neste arquivo! ──────────
# Use variáveis de ambiente seguras ou gerenciadores de segredos externos.
