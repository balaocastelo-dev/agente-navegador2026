# Agente Navegador - Balao da Informatica Castelo
# Variaveis de ambiente - COPIE este arquivo para .env e ajuste os valores
# NUNCA suba o arquivo .env para o repositorio!

# ── Navegador ──────────────────────────────────────────────────────────────
# false = navegador visivel (recomendado para uso supervisionado)
# true  = headless (sem interface visual)
BROWSER_HEADLESS=false

# Diretorio do perfil local do navegador (NAO suba para o GitHub)
BROWSER_PROFILE_DIR=browser-profile

# Timeout padrao para acoes do navegador (em milissegundos)
DEFAULT_TIMEOUT_MS=30000

# ── Diretorios ──────────────────────────────────────────────────────────────
# Onde salvar screenshots gerados pelo agente
SCREENSHOT_DIR=screenshots

# Onde salvar logs de execucao
LOG_DIR=logs

# ── Seguranca ───────────────────────────────────────────────────────────────
# true  = exige confirmacao antes de acoes criticas (RECOMENDADO)
# false = modo silencioso (NAO recomendado)
REQUIRE_CONFIRMATION=true

# ── Encoding (IMPORTANTE no Windows) ───────────────────────────────────────
# Garante que o terminal exiba caracteres especiais corretamente
PYTHONIOENCODING=utf-8

# ── NUNCA adicione tokens, senhas, chaves ou cookies neste arquivo! ──────────
# Use variaveis de ambiente seguras ou gerenciadores de segredos externos.
# GEMINI_API_KEY=sua_chave_aqui

